{
  "name": "agentgo-ui",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter @agentgo/ui-app dev",
    "build": "pnpm --filter @agentgo/ui build && pnpm --filter @agentgo/ui-app build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check app packages eslint.config.mjs package.json pnpm-workspace.yaml tsconfig.json .prettierrc.json",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.23.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.26.0",
    "vue-eslint-parser": "^10.1.1",
    "vue-tsc": "^2.2.8"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": ">=1.2.2"
    }
  }
}
